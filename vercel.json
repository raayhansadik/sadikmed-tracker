{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/tracker", "destination": "/index.html" },
    { "source": "/sadikmed", "destination": "/index.html" },
    { "source": "/sadikmed-tracker", "destination": "/index.html" },
    { "source": "/api/(.*)", "destination": "/server.js" }
  ],
  "functions": {
    "server.js": {
      "includeFiles": "{*.html,sw.js,assets/**,data/**}"
    }
  }
}
